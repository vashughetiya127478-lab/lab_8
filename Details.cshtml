@model InventoryItem
@{ ViewData["Title"] = "Item Details"; }
<h2>Item Details</h2>
<table class="details">
<tr><th>ID</th><td>@Model.ItemId</td></tr><tr><th>Name</th><td>@Model.ItemName</td></tr>
<tr><th>Category</th><td>@Model.Category</td></tr><tr><th>Quantity</th><td>@Model.Quantity</td></tr>
<tr><th>Unit Price</th><td>@Model.UnitPrice.ToString("0.00")</td></tr><tr><th>Supplier</th><td>@Model.Supplier</td></tr>
</table>
<a class="btn" href="/Inventory/Edit/@Model.ItemId">Edit</a> <a class="btn gray" href="/Inventory/Index">Back</a>
